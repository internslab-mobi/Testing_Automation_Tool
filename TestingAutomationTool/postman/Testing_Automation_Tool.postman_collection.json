							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && (jsonData.data.token || jsonData.data.accessToken)) {",
									"    var tok = jsonData.data.token || jsonData.data.accessToken;",
									"    pm.environment.set(\"accessToken\", tok);",
									"    pm.environment.set(\"token\", tok);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    }",
									"    console.log(\"Refreshed Access Token saved successfully!\");",
									"}"
								],
								"type": "text/javascript"
