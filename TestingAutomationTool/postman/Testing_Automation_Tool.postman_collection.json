							"raw": "{\n  \"username\": \"tester_qa_01\",\n  \"email\": \"tester_qa_01@example.com\",\n  \"password\": \"Tester@123\",\n  \"fullName\": \"QA Tester\",\n  \"designation\": \"Automation Engineer\",\n  \"role\": \"TESTER\"\n}"
						},
