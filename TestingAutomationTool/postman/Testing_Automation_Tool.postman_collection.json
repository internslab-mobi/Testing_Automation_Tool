					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = {};",
									"try { jsonData = pm.response.json(); } catch(e) {}",
									"var xsrf = pm.cookies.get('XSRF-TOKEN') || (jsonData && jsonData.data);",
									"if (xsrf) {",
									"    pm.environment.set(\"xsrfToken\", xsrf);",
