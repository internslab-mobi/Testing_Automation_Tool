{
	"info": {
		"_postman_id": "tat-api-collection-v2-full",
		"name": "Testing Automation Tool (TAT) - Complete Microservices API",
		"description": "Complete, end-to-end Postman Collection covering all services: API Gateway (8082), Auth Service (8081), Main Service (8090), Summary Export Service (8092), and Notification Service (8091).\n\nFeatures:\n- Auto-capture of Access Token & Refresh Token on login\n- Auto-injection of Bearer authorization headers\n- Auto-capture of CSRF tokens\n- Form-data, URL query, and JSON payloads ready for execution",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Automatically inject X-XSRF-TOKEN for state-changing requests when calling through Gateway",
					"const method = pm.request.method;",
					"if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {",
					"    const xsrf = pm.environment.get('xsrfToken');",
					"    if (xsrf) {",
					"        pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrf });",
					"    }",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "1. Authentication & Identity",
			"item": [
				{
					"name": "Login (Auto Token Capture)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && (jsonData.data.token || jsonData.data.accessToken)) {",
									"    var tok = jsonData.data.token || jsonData.data.accessToken;",
									"    pm.environment.set(\"accessToken\", tok);",
									"    pm.environment.set(\"token\", tok);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    }",
									"    if (jsonData.data.userId) {",
									"        pm.environment.set(\"userId\", jsonData.data.userId);",
									"    }",
									"    if (pm.cookies.get('XSRF-TOKEN')) {",
									"        pm.environment.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));",
									"    }",
									"    console.log(\"Access Token auto-saved successfully! User: \" + (jsonData.data.username || jsonData.data.email));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usernameOrEmail\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
